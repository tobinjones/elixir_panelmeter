# Config for the elixir-session bridge (~/.claude/skills/elixir-session).
# Copy to .session.env, which is git-ignored, and fill in the board's address.

# 'auto' asks the routing table for the address a peer would see us on. It must
# not be loopback — the board dials back, so bridge@127.0.0.1 is unreachable.
SESSION_HOST=auto

# The board names itself `panelmeter@<eth0 ip>` at runtime and shares the
# cluster cookie from panelmeter/config/site.exs. See Panelmeter.Distribution.
# Both ends are DHCP leases: if the board moves,
# `session.sh connect panelmeter@<new ip>` covers it until this line is updated.
SESSION_COOKIE=change_me_panelmeter_cluster
SESSION_CONNECT=panelmeter@192.0.2.10

# Distribution ports, kept off the ranges any firmware release pins.
SESSION_ERL="-kernel inet_dist_listen_min 9110 inet_dist_listen_max 9115"
